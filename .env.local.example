# Public — exposed to the browser (no secrets here)
NEXT_PUBLIC_GOVERNOR_ADDRESS=0x...
NEXT_PUBLIC_TOKEN_ADDRESS=0x...

# Server only — never exposed to the browser
RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/<KEY>
BACKEND_ACCOUNT_ADDRESS=0x...
BACKEND_ACCOUNT_PRIVATE_KEY=0x...
# local or gateway
PROVER=local
PROOF_SERVER_URL=http://localhost:3030
PROOF_GATEWAY_URL=https://xxx
# required for external server (e.g. snip36_...)
PROOF_GATEWAY_API_KEY=yyy
