# Network the DApp runs on: "sepolia" or "mainnet". Read at build time (Next.js inlines NEXT_PUBLIC_*),
# so restart `npm run dev` (or rebuild / redeploy) after changing it.
NEXT_PUBLIC_NETWORK=sepolia

# Optional: override the default contract addresses of a network (public values, no secrets here)
# NEXT_PUBLIC_SEPOLIA_GOVERNOR_ADDRESS=0x...
# NEXT_PUBLIC_SEPOLIA_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_MAINNET_GOVERNOR_ADDRESS=0x...
# NEXT_PUBLIC_MAINNET_TOKEN_ADDRESS=0x...

# ---- Server only — never exposed to the browser ----

# Alchemy key: the RPC URL is derived from it and from NEXT_PUBLIC_NETWORK
ALCHEMY_API_KEY=<KEY>

# Backend account of each network (signs the virtual transaction and submits the vote).
# Only the account of the active network is read; both can stay here.
SEPOLIA_BACKEND_ACCOUNT_ADDRESS=0x...
SEPOLIA_BACKEND_ACCOUNT_PRIVATE_KEY=0x...
MAINNET_BACKEND_ACCOUNT_ADDRESS=0x...
MAINNET_BACKEND_ACCOUNT_PRIVATE_KEY=0x...

# Proof server (secure-voty proofServer, branch proof-server-v2), through its public HTTPS address.
# The DApp appends /sepolia or /mainnet itself.
PROOF_SERVER_URL=https://<name>.duckdns.org
PROOF_SERVER_API_KEY=<site key>

# TEMPORARY — only for local tests, remove before production.
# Full address of ONE proof-server instance, used as is (no path added, no key sent).
# Change the port together with NEXT_PUBLIC_NETWORK (e.g. :3030 for sepolia, :3031 for mainnet).
# PROOF_SERVER_INSTANCE_URL=http://<lan-host>:3030
