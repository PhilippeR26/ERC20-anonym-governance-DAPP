# Network the DApp runs on: "sepolia" or "mainnet". Read at build time (Next.js inlines NEXT_PUBLIC_*),
# so restart `npm run dev` (or rebuild / redeploy) after changing it.
NEXT_PUBLIC_NETWORK=sepolia

# Optional: override the default contract addresses of a network (public values, no secrets here)
# NEXT_PUBLIC_SEPOLIA_GOVERNOR_ADDRESS=0x...
# NEXT_PUBLIC_SEPOLIA_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_MAINNET_GOVERNOR_ADDRESS=0x...
# NEXT_PUBLIC_MAINNET_TOKEN_ADDRESS=0x...

# ---- Server only — never exposed to the browser ----
# Fill in every variable of the network you run: the ones left empty are listed by the red banner at the top of the page.

# Alchemy key: the RPC URL is derived from it and from NEXT_PUBLIC_NETWORK
ALCHEMY_API_KEY=

# Backend account of each network (signs the virtual transaction and submits the vote), as 0x… hexadecimal numbers.
# Only the account of the active network is read; the other one can stay empty.
SEPOLIA_BACKEND_ACCOUNT_ADDRESS=
SEPOLIA_BACKEND_ACCOUNT_PRIVATE_KEY=
MAINNET_BACKEND_ACCOUNT_ADDRESS=
MAINNET_BACKEND_ACCOUNT_PRIVATE_KEY=

# Proof server (secure-voty proofServer, branch proof-server-v2), through its public HTTPS address,
# e.g. https://<name>.duckdns.org — the DApp appends /sepolia or /mainnet itself.
PROOF_SERVER_URL=
# Bearer key of this DApp's site on the proof server (required)
PROOF_SERVER_API_KEY=
